# Safer ServiceManager definition for recovery development
service servicemanager /system/bin/servicemanager
    class core       # Indicates it's a core system service (starts early)
    user system
    group system
    # Omit the 'critical' option to prevent recovery bootloops
    seclabel u:r:servicemanager:s0
# =========================================================
# =========================================================
# FBE DECRYPTION SERVICES (Keystore 2.0 dependencies)
# =========================================================

# 1. SharedSecret HAL (Loads the .so library)
# Uses the generic HAL manager binary to host the NDK library.
service sharedsecret /system/bin/vndservicemanager --path=/system/lib64/hw
    class hal
    user system
    group system
    seclabel u:r:sharedsecret:s0
    interface android.hardware.security.sharedsecret.ISharedSecret/default

# 2. KeyMint HAL (Executes the Trustonic binary)
service keymint /vendor/bin/hw/android.hardware.security.keymint-service.trustonic
    class hal
    user system
    group system
    seclabel u:r:keymint:s0
    interface android.hardware.security.keymint.IKeyMintDevice/default
    on restart:sharedsecret

# 3. Keystore 2.0 
# Addresses the original log error: Could not find 'aidl/android.system.keystore2.IKeystoreService/default'
service keystore2 /system/bin/keystore2
    class core
    user system
    group system
    capabilities SETUID SETGID
    seclabel u:r:keystore:s0
    interface android.system.keystore2.IKeystoreService/default
    on restart:keymint
# This service is the core of Android IPC (Binder).
service servicemanager /system/bin/servicemanager
    class core
    user system
    group system
    critical
    # This must be present for modern Android
    seclabel u:r:servicemanager:s0
service sharedsecret /system/bin/vndservicemanager --path=/system/lib64/hw ...
service keymint /vendor/bin/hw/android.hardware.security.keymint-service.trustonic ...
service keystore2 /system/bin/keystore2 ...
